{
  "name": "ai-drama-assistant",
  "version": "1.2.12",
  "description": "AI短剧助手：短剧下载、去重、剪映草稿与 AI 分镜（Windows / Apple Silicon Mac）",
  "main": "main.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "dev:react": "vite",
    "build:react": "vite build",
    "build": "npm run setup:whisper && npm run setup:transcription && npm run setup:structure && npm run setup:title-fonts && npm run setup:jianying && npm run build:react && electron-builder --win",
    "build:zip": "npm run setup:whisper && npm run setup:transcription && npm run setup:structure && npm run setup:title-fonts && npm run setup:jianying && npm run build:react && electron-builder --win --dir && node scripts/make-zip.js",
    "build:dir": "npm run setup:whisper && npm run setup:transcription && npm run setup:structure && npm run setup:title-fonts && npm run setup:jianying && npm run build:react && electron-builder --win --dir",
    "build:portable": "npm run setup:whisper && npm run setup:transcription && npm run setup:structure && npm run setup:title-fonts && npm run setup:jianying && npm run build:react && electron-builder --win portable",
    "build:installer": "npm run setup:whisper && npm run setup:transcription && npm run setup:structure && npm run setup:title-fonts && npm run setup:jianying && npm run build:react && electron-builder --win nsis",
    "check:quchong": "node scripts/check-quchong.cjs",
    "check:openai": "node scripts/check-openai-adapter.cjs",
    "check:pipeline": "node scripts/check-pipeline-gate.cjs",
    "check:whisper": "node scripts/check-whisper-adapter.cjs",
    "check:premium": "node scripts/check-premium-editing.cjs",
    "check:subtitles": "node scripts/check-transcription-manager.cjs && node scripts/check-subtitle-timing.cjs",
    "check:cut-points": "node scripts/check-cut-point-refiner.cjs",
    "setup:whisper": "node scripts/setup-whisper.js",
    "setup:transcription": "node scripts/setup-faster-whisper.cjs",
    "check:transcription-bundle": "node scripts/check-faster-whisper-bundle.cjs",
    "check:ai": "node scripts/check-openai-adapter.cjs && node scripts/check-ai-material-queue.cjs && node scripts/check-publish-materials.cjs && node scripts/check-publish-ipc.cjs",
    "pack": "npm run setup:transcription && npm run setup:structure && npm run setup:title-fonts && electron-builder --dir",
    "zip": "node scripts/make-zip.js",
    "setup:ffmpeg:mac": "node scripts/setup-ffmpeg-mac.js",
    "build:mac": "npm run setup:ffmpeg:mac && npm run setup:whisper && npm run setup:transcription && npm run setup:structure && npm run setup:title-fonts && npm run setup:jianying && npm run build:react && electron-builder --mac dmg --arm64 --publish never",
    "build:mac:dir": "npm run setup:ffmpeg:mac && npm run setup:whisper && npm run setup:transcription && npm run setup:structure && npm run setup:title-fonts && npm run setup:jianying && npm run build:react && electron-builder --mac --arm64 --dir --publish never",
    "check:workflow": "node scripts/check-workflow-wiring.cjs",
    "check:oneclick": "node scripts/check-oneclick.cjs",
    "check:synopsis": "node scripts/check-synopsis.cjs",
    "check:series-info": "node scripts/check-series-info.cjs",
    "check:series-library": "node scripts/check-series-library.cjs",
    "check:library-activity": "node scripts/check-library-activity.cjs",
    "check:resplit": "node scripts/check-resplit.cjs",
    "check:series-gaps": "node scripts/check-series-gaps.cjs",
    "setup:structure": "node scripts/setup-video-structure.cjs",
    "check:structure": "node scripts/check-video-structure.cjs",
    "check:shots": "python3 scripts/check-shot-boundary-convention.py && python3 scripts/check-shot-algorithm.py",
    "check:structure-bundle": "node scripts/check-video-structure-bundle.cjs",
    "setup:jianying": "node scripts/setup-jianying-runtime.cjs",
    "check:dialogue": "node scripts/check-dialogue-boundaries.cjs",
    "format": "npx --yes prettier@3 --write \"main.js\" \"preload.js\" \"vite.config.js\" \"index.html\" \"src/**/*.{js,jsx,cjs,css}\" \"scripts/**/*.{js,cjs}\"",
    "format:check": "npx --yes prettier@3 --check \"main.js\" \"preload.js\" \"vite.config.js\" \"index.html\" \"src/**/*.{js,jsx,cjs,css}\" \"scripts/**/*.{js,cjs}\"",
    "setup:title-fonts": "node scripts/setup-title-fonts.cjs",
    "check:poster-title": "node scripts/check-poster-title.cjs",
    "check:publish": "node scripts/check-publish-materials.cjs && node scripts/check-publish-ipc.cjs && node scripts/check-poster-title.cjs && node scripts/check-title-fonts.cjs"
  },
  "dependencies": {
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@fontsource/ma-shan-zheng": "5.3.1",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@fontsource/zcool-kuaile": "5.3.0",
    "@fontsource/zcool-qingke-huangyou": "5.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "globals": "15.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "io.github.jackotom.hongguo-drama-mac",
    "productName": "AI短剧助手",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist-react/**/*",
      "src/native/**/*",
      "src/store.js"
    ],
    "asar": true,
    "beforePack": "scripts/check-app-runtimes.cjs",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "build/ffmpeg",
          "to": "bin",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe",
            "SHA256SUMS",
            "*.txt",
            "COPYING.*",
            "LICENSE.md"
          ]
        },
        {
          "from": "build/whisper/win32-x64",
          "to": "bin",
          "filter": [
            "whisper-cli.exe"
          ]
        },
        {
          "from": "build/whisper/models",
          "to": "models",
          "filter": [
            "ggml-tiny.bin"
          ]
        },
        {
          "from": "build/whisper",
          "to": ".",
          "filter": [
            "WHISPER-LICENSE.txt"
          ]
        },
        {
          "from": "build/faster-whisper/win32-x64",
          "to": "faster-whisper"
        },
        {
          "from": "build/video-structure/win32-x64",
          "to": "video-structure"
        },
        {
          "from": "build/jianying/win32-x64",
          "to": "jianying"
        },
        {
          "from": "build/title-fonts",
          "to": "title-fonts"
        }
      ],
      "extraFiles": [
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-便携版.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI短剧助手",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "minimumSystemVersion": "13.0",
      "extraResources": [
        {
          "from": "build/ffmpeg/darwin-arm64",
          "to": "bin",
          "filter": [
            "ffmpeg",
            "ffprobe"
          ]
        },
        {
          "from": "build/ffmpeg",
          "to": "bin",
          "filter": [
            "COPYING.*",
            "LICENSE.md",
            "MACOS-*.txt"
          ]
        },
        {
          "from": "build/whisper/darwin-arm64",
          "to": "bin",
          "filter": [
            "whisper-cli"
          ]
        },
        {
          "from": "build/whisper/models",
          "to": "models",
          "filter": [
            "ggml-tiny.bin"
          ]
        },
        {
          "from": "build/whisper",
          "to": ".",
          "filter": [
            "WHISPER-LICENSE.txt"
          ]
        },
        {
          "from": "build/faster-whisper/darwin-arm64",
          "to": "faster-whisper"
        },
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        },
        {
          "from": "build/video-structure/darwin-arm64",
          "to": "video-structure"
        },
        {
          "from": "build/jianying/darwin-arm64",
          "to": "jianying"
        },
        {
          "from": "build/title-fonts",
          "to": "title-fonts"
        }
      ],
      "binaries": [
        "Contents/Resources/bin/ffmpeg",
        "Contents/Resources/bin/ffprobe",
        "Contents/Resources/bin/whisper-cli",
        "Contents/Resources/faster-whisper/transcribe-worker",
        "Contents/Resources/video-structure/worker/structure-worker",
        "Contents/Resources/video-structure/bin/sherpa-onnx-offline-source-separation",
        "Contents/Resources/jianying/jianying-runtime"
      ]
    },
    "extraResources": [
      {
        "from": "scripts/create-jianying-draft.py",
        "to": "workflow/create-jianying-draft.py"
      },
      {
        "from": "scripts/create-jianying-simple-draft.py",
        "to": "workflow/create-jianying-simple-draft.py"
      },
      {
        "from": "scripts/check-jianying-draft.py",
        "to": "workflow/check-jianying-draft.py"
      }
    ]
  },
  "engines": {
    "node": ">=22.12"
  }
}
