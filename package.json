{
  "name": "hongguo-downloader",
  "version": "1.1.30",
  "description": "红果短剧全集批量下载器（Windows / Apple Silicon Mac）",
  "main": "main.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "dev:react": "vite",
    "build:react": "vite build",
    "build": "npm run setup:whisper && npm run setup:transcription && npm run build:react && electron-builder --win",
    "build:zip": "npm run setup:whisper && npm run setup:transcription && npm run build:react && electron-builder --win --dir && node scripts/make-zip.js",
    "build:dir": "npm run setup:whisper && npm run setup:transcription && npm run build:react && electron-builder --win --dir",
    "build:portable": "npm run setup:whisper && npm run setup:transcription && npm run build:react && electron-builder --win portable",
    "build:installer": "npm run setup:whisper && npm run setup:transcription && npm run build:react && electron-builder --win nsis",
    "check:quchong": "node scripts/check-quchong.cjs",
    "check:openai": "node scripts/check-openai-adapter.cjs",
    "check:pipeline": "node scripts/check-pipeline-gate.cjs",
    "check:whisper": "node scripts/check-whisper-adapter.cjs",
    "check:premium": "node scripts/check-premium-editing.cjs",
    "check:subtitles": "node scripts/check-transcription-manager.cjs && node scripts/check-subtitle-timing.cjs",
    "check:cut-points": "node scripts/check-cut-point-refiner.cjs",
    "setup:whisper": "node scripts/setup-whisper.js",
    "setup:transcription": "node scripts/setup-faster-whisper.cjs",
    "check:transcription-bundle": "node scripts/check-faster-whisper-bundle.cjs",
    "check:ai": "node scripts/check-openai-adapter.cjs && node scripts/check-ai-material-queue.cjs && node scripts/check-ai-materials-panel.cjs",
    "pack": "npm run setup:transcription && electron-builder --dir",
    "zip": "node scripts/make-zip.js",
    "setup:ffmpeg:mac": "node scripts/setup-ffmpeg-mac.js",
    "build:mac": "npm run setup:ffmpeg:mac && npm run setup:whisper && npm run setup:transcription && npm run build:react && electron-builder --mac dmg --arm64 --publish never",
    "build:mac:dir": "npm run setup:ffmpeg:mac && npm run setup:whisper && npm run setup:transcription && npm run build:react && electron-builder --mac --arm64 --dir --publish never"
  },
  "dependencies": {
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "io.github.jackotom.hongguo-drama-mac",
    "productName": "红果短剧",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist-react/**/*",
      "src/native/**/*",
      "src/store.js"
    ],
    "asar": true,
    "beforePack": "scripts/check-faster-whisper-bundle.cjs",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "build/ffmpeg",
          "to": "bin",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe",
            "SHA256SUMS",
            "*.txt",
            "COPYING.*",
            "LICENSE.md"
          ]
        },
        {
          "from": "build/whisper/win32-x64",
          "to": "bin",
          "filter": ["whisper-cli.exe"]
        },
        {
          "from": "build/whisper/models",
          "to": "models",
          "filter": ["ggml-tiny.bin"]
        },
        {
          "from": "build/whisper",
          "to": ".",
          "filter": ["WHISPER-LICENSE.txt"]
        },
        {
          "from": "build/faster-whisper/win32-x64",
          "to": "faster-whisper"
        }
      ],
      "extraFiles": [
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-便携版.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "红果短剧下载器",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "minimumSystemVersion": "13.0",
      "extraResources": [
        {
          "from": "build/ffmpeg/darwin-arm64",
          "to": "bin",
          "filter": [
            "ffmpeg",
            "ffprobe"
          ]
        },
        {
          "from": "build/ffmpeg",
          "to": "bin",
          "filter": [
            "COPYING.*",
            "LICENSE.md",
            "MACOS-*.txt"
          ]
        },
        {
          "from": "build/whisper/darwin-arm64",
          "to": "bin",
          "filter": ["whisper-cli"]
        },
        {
          "from": "build/whisper/models",
          "to": "models",
          "filter": ["ggml-tiny.bin"]
        },
        {
          "from": "build/whisper",
          "to": ".",
          "filter": ["WHISPER-LICENSE.txt"]
        },
        {
          "from": "build/faster-whisper/darwin-arm64",
          "to": "faster-whisper"
        },
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        }
      ],
      "binaries": [
        "Contents/Resources/bin/ffmpeg",
        "Contents/Resources/bin/ffprobe",
        "Contents/Resources/bin/whisper-cli",
        "Contents/Resources/faster-whisper/hongguo-transcribe"
      ]
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
